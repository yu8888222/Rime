#h配色方案https://github.com/rime/weasel/wiki
patch:
  #style/horizontal: true  # 候選橫排
  style/font_point: 14 #字號，只認數字的，不認「五號」、「小五」這樣的
  style/font_face: "宋体"  # 字體名稱，從記事本等處的系統字體對話框裏能看到  
  style/inline_preedit: false # 输入内容是否在文本框中
  style/translucency: true      # 透明度總開關
  #style/display_tray_icon: true  # 顯示托盤圖標
  
  
  style/antialias_mode: subpixel #抗锯齿模式：默认
  #style/ascii_tip_follow_cursor: false #跟随光标：否
  #candidate_abbreviate_length: 0 #候选词缩写长度：0
  #style/click_to_capture: true #点击捕获
  
  #style/fullscreen: true  #全屏：否

  #style/hover_type: none #悬停类型：无经济困境
  style/label_format: "" #标签格式："%s."
  
  
  
  style/color_scheme: myThem1    # 這項用於選中下面定義的新方案
 
  
  style/layout:
  
    #align_type: center  #将候选框内容对齐到中心
    #baseline: 0 #控制候选框的基准线位置，通常用于调整垂直对齐
    
    
  
    
    
    linespacing: 0  #候选框的行间距
    
    margin_x: 15    #候选内容与整体框的水平内边距
    margin_y: 10
    border_width: 1 #整体边框宽度，0表示无边框
    
    
    min_width: 150  #整体候选框最小宽度0 表示无限制
    min_height: 50
    max_height: 0   
    max_width: 0
    
    
    
    shadow_offset_x: 2
    shadow_offset_y: 2
    
    #圆角
    shadow_radius: 2 # 阴影尺寸0则隐藏阴影
    corner_radius: 10    #圆角
    round_corner: 10 #选中的候选背景圆角
    #shadow_blur: 3  # 阴影模糊程度为 3 个单位
  
    
    #shadow_radius: 6
    spacing: 10  #词码间距，输入行与候选的间距
   
    candidate_spacing: 0   #候选项之间的水平或垂直间距
    hilite_spacing: 0   #序词间距，候选词序号与内容的距离

    #选中候选
    hilite_padding: 4   #高亮填充，候选项高亮区域的内边距大小
    
 

   
   
  preset_color_schemes/myThem1:  # 在配色方案列表裏加入標識爲 starcraft 的新方案
  
    name: myThem2
    author: 小闫同学
    back_color: 0xFFFFFF
    border_color: 0xFFE9D6
    text_color: 0xFF9F48
    hilited_text_color: 0xFF9F48
    hilited_back_color: 0xFFFFFF
    hilited_candidate_text_color: 0x1D71ED
    hilited_candidate_back_color: 0xFFFFFF
    candidate_text_color: 0xFFB97B
    comment_text_color: 0xFFE9D6
    
    shadow_color: 0xFFE9D6  
    
    # nextpage_color: 0x000000                # inline_preedit: false 翻页箭头颜色：下一页；不设置则不显示箭头
    # prevpage_color: 0x000000
    
  

    
  preset_color_schemes/myThem2:  
                                           # 在 style/color_schema 指定的配色方案值
    name: 碧水／Aqua                              # 方案设置中显示的配色名称
    author: 小闫同学                             # 配色作者名称
    # color_format: abgr                          # 颜色格式：argb；rgba；abgr（默认）
    text_color: 0x000000                          # 默认文字颜色
    # comment_text_color: 0x000000                # 注释文字颜色
    # label_color: 0x000000                       # 标签文字颜色
    back_color: 0xeceeee                          # 候选窗背景色
    shadow_color: 0x000000                      # 候选窗阴影色
    border_color: 0xe0e0e0                        # 候选窗边框颜色
    hilited_text_color: 0x000000                  # 编码文字颜色
    hilited_back_color: 0xd4d4d4                  # 编码背景颜色
    hilited_shadow_color: 0x000000              # 编码背景块阴影颜色
    hilited_candidate_text_color: 0xffffff        # 高亮候选文字颜色
    hilited_candidate_back_color: 0xfa3a0a        # 高亮候选背景颜色
    hilited_candidate_shadow_color: 0x00000000    # 高亮候选背景块阴影颜色
    # hilited_candidate_border_color: 0xe0e0e0    # 高亮候选边框颜色
    # hilited_label_color: 0x000000               # 高亮候选的标签颜色
    # hilited_mark_color: 0x000000                # 高亮候选前的标记颜色
    # hilited_comment_text_color: 0x000000        # 高亮候选的注释颜色
    candidate_text_color: 0x000000                # 非高亮候选文字颜色
    candidate_back_color: 0xeceeee                # 非高亮候选背景颜色
    candidate_shadow_color: 0x000000            # 非高亮候选背景块阴影颜色
    # candidate_border_color: 0xe0e0e0            # 非高亮候选的边框颜色
                 # inline_preedit: false 翻页箭头颜色：上一页；不设置则不显示箭头